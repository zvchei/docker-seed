[
    {
        "name": "chrome",
        "enabled": true,
        "templates": [
            "node",
            "chrome"
        ],
        "cmd": [
            "/bin/bash"
        ],
        "interactive": true,
        "ports": [],
        "volumes": {
            "xdg_cache": {
                "path": ".cache",
                "container_specific": true
            }
        },
        "env_vars": {
            "CHROME_PATH": "/usr/bin/google-chrome",
            "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/google-chrome",
            "PUPPETEER_SKIP_DOWNLOAD": "true",
            "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
        }
    }
]