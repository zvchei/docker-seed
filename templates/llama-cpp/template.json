{
    "description": "llama.cpp CUDA binaries",
    "requires": ["huggingface-cache"],
    "apt_packages": ["ca-certificates", "libgomp1"],
    "assets": [
        {
            "url": "https://github.com/ggml-org/llama.cpp/releases/download/b11476/llama-b11476-bin-ubuntu-cuda-12.8-x64.tar.gz",
            "filename": "llama-b11476-bin-ubuntu-cuda-12.8-x64.tar.gz"
        },
        {
            "url": "https://github.com/ggml-org/llama.cpp/releases/download/b11476/cudart-llama-b11476-bin-ubuntu-cuda-12.8-x64.tar.gz",
            "filename": "cudart-llama-b11476-bin-ubuntu-cuda-12.8-x64.tar.gz"
        }
    ],
    "volumes": {
        "llama_cpp": ".llama.cpp",
        "models": "models"
    },
    "ports": ["8090:8090"],
    "cmd": ["llama", "serve", "--host", "0.0.0.0", "--port", "8090", "--models-dir", "../models"]
}
